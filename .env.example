# DeepSeek API (https://api.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080

# Database
POSTGRES_USER=offer
POSTGRES_PASSWORD=offer123
POSTGRES_DB=offer_catch
DATABASE_URL=postgresql+asyncpg://offer:offer123@db:5432/offer_catch

# Redis（登录限流 + 热点缓存）
REDIS_URL=redis://redis:6379/0
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_MAX_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
CACHE_TTL_JOBS_LIST=60
CACHE_TTL_JOB_DETAIL=300
CACHE_TTL_PROFILE=120

# App
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# 邮箱验证（QQ：SMTP 授权码在 QQ 邮箱设置里生成）
APP_PUBLIC_URL=http://localhost:8080
EMAIL_VERIFY_EXPIRE_HOURS=24
EXPOSE_DEV_VERIFY_LINK=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Offer Catch <your@qq.com>

# Docker Hub 慢时可取消注释：POSTGRES_IMAGE=docker.1ms.run/library/postgres:16-alpine 等
# NPM_REGISTRY=https://registry.npmmirror.com

COMPOSE_PROJECT_NAME=offer-hunter
